# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase (Beacon's own project — do not reuse APEX's) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Check-in email notifications (lib/notifications) ---
# Optional — if both unset, check-ins are still recorded and visible on the
# dashboard, just no email goes out. Get a key at https://sendgrid.com.
SENDGRID_API_KEY=
# Must be a verified sender identity (or a verified domain address) in your
# SendGrid account — SendGrid will reject sends from anything else.
SENDGRID_FROM_EMAIL=

# --- Scheduled jobs (vercel.json crons) ---
# Vercel sets this automatically as a project env var and sends it as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests. Set it
# here too for local testing. Generate any long random string.
CRON_SECRET=

# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase (Beacon's own project — do not reuse APEX's) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- QuickBooks ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" or "production" — picks the Accounting API host and the Intuit
# app-center authorize URL. Defaults to sandbox if unset.
QUICKBOOKS_ENVIRONMENT=sandbox

# --- Risk analysis engine (lib/risk-engine) ---
# Used by lib/groq/client.ts to write plain-language flag explanations.
GROQ_API_KEY=
# Shared secret required on POST /api/risk-analysis. Generate any long random string.
RISK_ANALYSIS_TRIGGER_SECRET=

# --- Risk flag email notifications (lib/notifications) ---
# Optional — if both unset, risk flags are still written and visible on the
# dashboard, just no email goes out. Get a key at https://sendgrid.com.
SENDGRID_API_KEY=
# Must be a verified sender identity (or a verified domain address) in your
# SendGrid account — SendGrid will reject sends from anything else.
SENDGRID_FROM_EMAIL=

# --- Scheduled sync (vercel.json crons -> /api/cron/quickbooks-sync) ---
# Vercel sets this automatically as a project env var and sends it as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests. Set it
# here too for local testing. Generate any long random string.
CRON_SECRET=

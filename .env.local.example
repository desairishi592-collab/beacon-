# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase (Beacon's own project — do not reuse APEX's) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- QuickBooks ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" or "production" — picks the Accounting API host and the Intuit
# app-center authorize URL. Defaults to sandbox if unset.
QUICKBOOKS_ENVIRONMENT=sandbox

# --- Risk analysis engine (lib/risk-engine) ---
ANTHROPIC_API_KEY=
# Shared secret required on POST /api/risk-analysis. Generate any long random string.
RISK_ANALYSIS_TRIGGER_SECRET=

# --- TEMPORARY DEV-ONLY: skip real login, act as a fixed test user. ---
# See lib/dev-auth.ts. REMOVE before this app goes anywhere near real users.
# DEV_AUTH_BYPASS=true
